# FastAPI 是否启用调试模式；开启后会暴露 docs / redoc
WFM_DEBUG=true

# 允许访问后端的前端来源列表，使用 JSON 数组格式
WFM_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# 说明：本文件仅保留本地 dev 后端启动所需字段，且这些字段都应能在 docker/.env 中找到对应项

# 后台登录 token 的有效期，单位为分钟；1440 = 24 小时
WFM_AUTH_TOKEN_EXPIRE_MINUTES=1440

# 是否启用 MQTT 相关服务；关闭后客户端绑定、远程控制和 MQTT 状态检测全部禁用
WFM_ENABLE_MQTT_SERVICES=true

# 本地后端连接 MQTT broker 的地址
WFM_MQTT_URL=mqtt://127.0.0.1:1883

# 本地后端连接 EMQX 管理 API 的地址
WFM_EMQX_API_BASE_URL=http://127.0.0.1:18083

# EMQX 统一账号密码：同时用于 Dashboard、管理 API 与服务端 MQTT 超级用户
WFM_EMQX_USERNAME=admin
WFM_EMQX_PASSWORD=public

# EMQX 回查 wfm 内部授权接口时使用的共享密钥
WFM_EMQX_AUTHZ_SHARED_KEY=wfm-internal-emqx-authz

# 控制台默认显示时区；默认使用北京时间
WFM_TIMEZONE=Asia/Shanghai

# 是否开启 /api/v0 开发测试接口；默认关闭，只有本地调试时才建议开启
WFM_ENABLE_DEV_TEST_API=false
