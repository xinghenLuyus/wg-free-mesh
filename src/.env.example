# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# 后端运行模式。开启后暴露 docs / redoc；生产部署应保持 false。
WFM_DEBUG=true

# 开发例外开关。开启后注册 /api/v0，并跳过正式来源限制；生产部署必须保持 false。
WFM_ENABLE_DEV_TEST_API=false

# 控制台默认显示时区；时间仍按 UTC 存储。
WFM_TIMEZONE=Asia/Shanghai

# 后台登录 token 有效期，单位分钟。
WFM_AUTH_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Public access
# ---------------------------------------------------------------------------
# 服务主来源。正式模式下外部请求 Host 必须与该来源一致；本地开发可留空。
WFM_PUBLIC_ORIGIN=

# 额外允许来源，使用 JSON 数组格式；只扩展 Origin，不扩展 Host。
WFM_EXTRA_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# 后端数据库连接。本地开发默认使用 SQLite。
WFM_DATABASE=sqlite:///./data/wg_free_mesh.db

# ---------------------------------------------------------------------------
# MQTT / EMQX
# ---------------------------------------------------------------------------
# 是否启用客户端绑定、MQTT 通信和远程控制能力。
WFM_ENABLE_MQTT_SERVICES=true

# 后端连接 MQTT broker 的地址。是否使用 TLS 只由 URL scheme 决定。
WFM_MQTT_URL=mqtt://127.0.0.1:1883

# 客户端 MQTT 接入端口。host 默认来自 WFM_PUBLIC_ORIGIN 的主机；未设置时回退 localhost。
WFM_MQTT_PUBLIC_PORT=1883
WFM_MQTT_PUBLIC_TLS_PORT=8883

# 是否启用客户端 MQTT TLS，并作为客户端绑定配置默认值；不影响后端连接 EMQX。
WFM_MQTT_TLS_ENABLED=false

# 后端连接 EMQX 管理 API 的地址。
WFM_EMQX_API_BASE_URL=http://127.0.0.1:18083

# EMQX 统一账号密码：同时用于 Dashboard、管理 API 与服务端 MQTT 超级用户。
WFM_EMQX_USERNAME=admin
WFM_EMQX_PASSWORD=public

# EMQX 回查 WFM 内部授权接口时使用的共享密钥。
WFM_EMQX_AUTHZ_SHARED_KEY=wfm-internal-emqx-authz
