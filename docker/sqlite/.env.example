# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# App 镜像版本。留空默认使用 latest；生产环境如需固定版本可设置为 1.0.0 或 1.0.0-rc.1。
# WFM_IMAGE_TAG=1.0.0

# 后端运行模式。生产部署应保持 false。
WFM_DEBUG=false

# 开发例外开关。开启后注册 /api/v0，并跳过正式来源限制；生产部署必须保持 false。
WFM_ENABLE_DEV_TEST_API=false

# 控制台默认显示时区；时间仍按 UTC 存储。
WFM_TIMEZONE=Asia/Shanghai

# 后台登录 token 有效期，单位分钟。
WFM_AUTH_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Public access / gateway
# ---------------------------------------------------------------------------
# 服务主来源。Docker gateway 默认从该地址承接控制台、API、SSE 和 MCP。
WFM_PUBLIC_ORIGIN=http://localhost:8000

# 额外允许来源，使用 JSON 数组格式；只扩展 Origin，不扩展 Host。
WFM_EXTRA_ALLOWED_ORIGINS=[]

# 宿主机暴露的 gateway Web 端口；容器内 app 固定监听 8000。
WFM_APP_PORT=8000

# gateway 允许上传的最大请求体；快照导入也受该值限制。
WFM_GATEWAY_CLIENT_MAX_BODY_SIZE=512m

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# 后端数据库连接。SQLite 模式使用容器内 ./data/wg_free_mesh.db，并挂载到项目 src/data。
WFM_DATABASE=sqlite:///./data/wg_free_mesh.db

# ---------------------------------------------------------------------------
# MQTT / EMQX
# ---------------------------------------------------------------------------
# 是否启用客户端绑定、MQTT 通信和远程控制能力。
WFM_ENABLE_MQTT_SERVICES=true

# 启用 mqtt profile 才会创建 EMQX；关闭 MQTT 时留空并同步把 WFM_ENABLE_MQTT_SERVICES 改为 false。
COMPOSE_PROFILES=mqtt

# 后端连接 MQTT broker 的内部地址。默认走 Docker 网络内明文 1883。
WFM_MQTT_URL=mqtt://emqx:1883

# 客户端 MQTT 接入端口。host 默认来自 WFM_PUBLIC_ORIGIN 的主机。
WFM_MQTT_PUBLIC_PORT=1883
WFM_MQTT_PUBLIC_TLS_PORT=8883

# 是否启用 EMQX 客户端 TLS listener，并作为客户端绑定配置默认值；不影响后端连接 EMQX。
WFM_MQTT_TLS_ENABLED=true

# 后端访问 EMQX 管理 API 的内部地址。
WFM_EMQX_API_BASE_URL=http://emqx:18083

# EMQX 统一账号密码：同时用于 Dashboard、管理 API 与服务端 MQTT 超级用户。
WFM_EMQX_USERNAME=admin
WFM_EMQX_PASSWORD=public

# EMQX 节点 cookie；单节点部署保持固定即可，多节点集群必须各节点一致。
WFM_EMQX_NODE_COOKIE=wfm-emqx-cookie

# EMQX HTTP AuthZ 回查共享密钥；生产环境必须改成高强度随机值。
WFM_EMQX_AUTHZ_SHARED_KEY=wfm-internal-emqx-authz

# EMQX 回调后端做 topic 授权的内部地址。Docker 网络内使用 app:8000。
WFM_EMQX_AUTHZ_URL=http://app:8000/api/internal/emqx/authz
# WFM_EMQX_AUTHZ_URL=http://host.docker.internal:8000/api/internal/emqx/authz
