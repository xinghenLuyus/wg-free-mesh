# 后端运行模式。生产部署建议保持 false。
WFM_DEBUG=false

# 后端允许的浏览器来源。Docker 默认由后端 8000 端口托管前端。
WFM_CORS_ORIGINS=["http://localhost:8000"]

# 宿主机暴露的 App 端口，只影响 Docker 端口映射，不改变容器内后端监听端口。
WFM_APP_PORT=8000

# 数据库连接。SQLite 模式使用容器内 ./data/wg_free_mesh.db，并通过 compose 挂载到项目 src/data。
WFM_DATABASE=sqlite:///./data/wg_free_mesh.db

# 后端连接 EMQX 的内部 MQTT 地址。默认走 Docker 网络内明文 1883。
WFM_MQTT_URL=mqtt://emqx:1883

# 后端访问 EMQX 管理 API 的内部地址。
WFM_EMQX_API_BASE_URL=http://emqx:18083

# 是否启用客户端绑定、MQTT 通信和远程控制能力。
WFM_ENABLE_MQTT_SERVICES=true

# 客户端 MQTT 接入主机，仅用于生成客户端绑定配置；生产环境通常改成服务器公网 IP 或域名。
WFM_MQTT_PUBLIC_HOST=localhost

# 客户端明文 MQTT 接入端口，应与 compose 暴露的 1883 映射保持一致。
WFM_MQTT_PUBLIC_PORT=1883

# 客户端 TLS MQTT 接入端口，应与 compose 暴露的 8883 映射保持一致。
WFM_MQTT_PUBLIC_TLS_PORT=8883

# 是否启用 EMQX 客户端 TLS listener，并作为客户端绑定配置的默认 TLS 开关；不影响后端连接 EMQX。
WFM_MQTT_TLS_ENABLED=true

# EMQX 管理员账号，同时用于 Dashboard、管理 API 和后端 MQTT 高权限用户。
WFM_EMQX_USERNAME=admin
WFM_EMQX_PASSWORD=public

# EMQX 节点 cookie，单节点部署保持固定即可；多节点集群必须各节点一致。
WFM_EMQX_NODE_COOKIE=wfm-emqx-cookie

# EMQX HTTP AuthZ 回查共享密钥，生产环境必须改成高强度随机值。
WFM_EMQX_AUTHZ_SHARED_KEY=wfm-internal-emqx-authz

# EMQX 回调后端做 topic 授权的内部地址。Docker 网络内使用 app:8000。
WFM_EMQX_AUTHZ_URL=http://app:8000/api/internal/emqx/authz

# 后台登录 token 有效期，单位分钟。
WFM_AUTH_TOKEN_EXPIRE_MINUTES=1440

# 后端展示和事件时间使用的默认时区。
WFM_TIMEZONE=Asia/Shanghai

# 开发测试接口开关。生产环境必须保持 false。
WFM_ENABLE_DEV_TEST_API=false
