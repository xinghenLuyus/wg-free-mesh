# Docker / Compose 专用环境变量。
# 本文件供 docker compose 与容器内 app / emqx 共同使用。
# 在 Docker 场景中，这里应包含 app 运行所需的完整环境变量集合。
# 即使 src/.env 也存在，容器仍以 docker/.env 注入结果为准。
# src/.env 只应保留本地 dev 后端所需字段，且应是本文件的子集。

# FastAPI 在容器内的基础运行模式
WFM_DEBUG=false
WFM_CORS_ORIGINS=["http://localhost:8000"]

# app 只在容器内监听 8000；这里仅控制 Docker 映射到宿主机的端口
WFM_APP_PORT=8000

# app 容器访问 EMQX 的内部地址；Docker 默认走明文，后端是否使用 TLS 只由 URL scheme 决定，不受 WFM_MQTT_TLS_ENABLED 影响
WFM_MQTT_URL=mqtt://emqx:1883
WFM_EMQX_API_BASE_URL=http://emqx:18083
WFM_ENABLE_MQTT_SERVICES=true

# 客户端 MQTT 引导默认主机，仅用于客户端连接提示；可配置为服务主机的域名或 IP
WFM_MQTT_PUBLIC_HOST=localhost

# 客户端 MQTT 引导中的明文监听端口，同时控制 Docker 映射到宿主机的端口
WFM_MQTT_PUBLIC_PORT=1883

# 客户端 MQTT 引导中的 TLS 监听端口，同时控制 Docker 映射到宿主机的端口
WFM_MQTT_PUBLIC_TLS_PORT=8883

# EMQX 容器是否开启客户端 TLS listener，并作为客户端 MQTT 引导默认 TLS 开关；不影响后端连接 EMQX
WFM_MQTT_TLS_ENABLED=true

# EMQX 统一账号密码：同时用于 Dashboard、管理 API 与服务端 MQTT 超级用户
WFM_EMQX_USERNAME=admin
WFM_EMQX_PASSWORD=public

# EMQX Erlang 集群 cookie；单机也建议显式配置，避免使用默认不安全值
WFM_EMQX_NODE_COOKIE=wfm-emqx-cookie

# EMQX 回查 wfm 内部授权接口时使用的共享密钥
WFM_EMQX_AUTHZ_SHARED_KEY=wfm-internal-emqx-authz

# EMQX 在容器内回查宿主机 dev 后端的地址
WFM_EMQX_AUTHZ_URL=http://app:8000/api/internal/emqx/authz
# WFM_EMQX_AUTHZ_URL=http://host.docker.internal:8000/api/internal/emqx/authz

# 后台登录 token 的有效期，单位为分钟；1440 = 24 小时
WFM_AUTH_TOKEN_EXPIRE_MINUTES=1440

# 控制台默认显示时区；默认使用北京时间
WFM_TIMEZONE=Asia/Shanghai

# 是否开启 /api/v0 开发测试接口；默认关闭
WFM_ENABLE_DEV_TEST_API=false
